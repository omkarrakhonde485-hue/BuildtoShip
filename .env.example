# ============================================
# NEXUS AI — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI (REQUIRED)
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth (for Drive/Calendar/Gmail)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=nexus-ai-encryption-key-change-me

# Make.com (optional)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-url
